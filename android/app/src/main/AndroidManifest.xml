<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Internet: server API calls (heartbeat, status, notification sync) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Auto-start after reboot / app update / network return, so a device that
         was set up once keeps reporting without the user opening the app. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Call recording: the device's own microphone plus call state, so the
         recorder only starts once the other side actually picks up. Recording
         is armed by the phone owner in-app, shows a persistent notification
         and Android's mic indicator, and is deleted from the phone after
         upload. It captures the device microphone only — Android gives no app
         access to the other party's audio. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />

    <!-- Notification sync: user grants Notification Listener access in Settings.
         Purpose explained in-app before the settings deep-link. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Required to raise the screen-share consent prompt while the app is in
         the background (Android 10+ blocks background activity launches). -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Remote photo capture without a per-photo tap: the one-time "display
         over other apps" grant (Setup) lets the app raise its own transparent
         capture activity while in the background, which is also the only way
         Android 11+ allows a camera open with no visible activity. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Battery-optimization exemption (Setup toggle): the durable fix for
         OEM skins that kill even foreground services. The request dialog is
         shown by Android itself; the owner decides. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Data sync permissions: each is requested at runtime ONLY when the user
         enables that feature in the app, with an explanation screen first.
         Revoking any of them in Android Settings disables that sync instantly. -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <!-- Camera: only ever opened for a single, on-request frame. Requires the
         dashboard's camera capability AND the user's runtime permission. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!-- Installed apps + usage statistics (which apps, how long each was used).
         PACKAGE_USAGE_STATS is an AppOps toggle the user flips in Settings, not
         a dialog — Android requires that for usage data. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- Package visibility (Android 11+). ConnectDesk is a device-management
         app, which is one of the permitted uses for this permission; it is
         used only to list which apps are installed, never to read their data. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- Reading the shared file index (Android 11+ scoped storage). -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.ConnectDesk"
        android:allowBackup="false">

        <!-- Visible main activity: pairing + status + disconnect.
             This app NEVER hides its icon; uninstall is always possible. -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Screen-share consent host: transparent, launched only when the
             dashboard requests a screen session. The OS MediaProjection
             dialog it raises CANNOT be suppressed — explicit consent. -->
        <activity
            android:name=".ScreenConsentActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Foreground service: keeps heartbeat + notification sync alive while
             connected. Shows a persistent "ConnectDesk connected" notification. -->
        <service
            android:name=".DeviceService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Auto-restart receiver: reboot, app update, and network return all
             bring the sync service back without opening the app. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <!--
                    Delivered to manifest receivers only below Android 8, but
                    harmless to keep: on newer devices the running service's
                    1-second loop notices connectivity return on its own, and
                    the watchdog below covers the killed-service case.
                -->
                <action android:name="android.net.conn.CONNECTIVITY_CHANGE" />
            </intent-filter>
        </receiver>

        <!-- Watchdog: a slow (15-min) alarm that revives DeviceService when an
             OEM skin kills even the foreground service and skips the sticky
             restart. Self-perpetuating; needs no extra permission. -->
        <receiver
            android:name=".WatchdogReceiver"
            android:exported="false"
            android:enabled="true" />

        <!-- Uninstall attempt intercept: fires when admin/owner state changes,
             and reinforces the protection message on the phone. Note: the actual
             Settings > Apps uninstall button lives in Android OS UI and cannot be
             hidden by any app. Device-owner status is what makes the OS disable
             that button; this receiver adds the visible message. -->
        <receiver
            android:name=".UninstallInterceptReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.app.admin.action.DEVICE_ADMIN_ENABLED" />
                <action android:name="android.app.admin.action.DEVICE_ADMIN_DISABLED" />
            </intent-filter>
        </receiver>

        <!-- Device-owner protection: catches uninstall / force-stop / package
             change signals and restores the service + watchdog immediately, plus
             shows a clear message. The actual Settings > Apps buttons are Android
             OS UI and cannot be hidden; device-owner status is what disables them
             on most platforms. This service is the belt under that. -->
        <receiver
            android:name=".DeviceOwnerProtectService"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_REMOVED" />
                <action android:name="android.intent.action.PACKAGE_CHANGED" />
                <action android:name="android.intent.action.PACKAGE_REPLACED" />
            </intent-filter>
            <meta-data
                android:name="android.content.PERMISSION_REQUIRED"
                android:value="false" />
        </receiver>

        <!-- Device admin: the owner activates it once in Setup. It prevents
             silent uninstall (deactivation is visible on the phone) and
             enables the remote screen lock. Policy set is force-lock only. -->
        <receiver
            android:name=".AdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_policies" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- Camera capture host: transparent, opens for exactly one frame.
             Raised directly when "display over other apps" is granted (no tap);
             the tap-to-allow notification reaches it only as a fallback. -->
        <activity
            android:name=".CameraConsentActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Call recorder. Armed ONLY by the phone owner via the in-app switch;
             the dashboard can switch it off remotely but never on. Records the
             device microphone, shows a persistent notification for the whole
             call, and deletes the file after upload. -->
        <service
            android:name=".CallRecorderService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Screen capture service (Android 10+): streams JPEG frames only
             while a screen session is active. Shows its own persistent
             notification with a Stop button; ends when the user or the
             dashboard stops the session. -->
        <service
            android:name=".ScreenCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!--
             Live camera streaming. Armed ONLY by the phone owner from the
             app's own UI; the dashboard can request a stop but can never
             start it. While it runs it must hold the CAMERA foreground
             service type, and Android shows a permanent notification for
             that, which is the visible consent signal.
        -->
        <service
            android:name=".CameraLiveService"
            android:exported="false"
            android:foregroundServiceType="camera" />

        <!-- Live microphone streaming. Armed ONLY by the phone owner from the
             app; the dashboard can listen and ask it to stop, never start it.
             Android requires the microphone foreground-service type plus a
             permanent notification, and that notification is the visible
             consent signal — it is not decoration. -->
        <service
            android:name=".MicLiveService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Notification listener: syncs notifications to the dashboard, only
             while the user enabled it AND the dashboard toggle is on. Content
             is masked on-device before leaving the phone. -->
        <service
            android:name=".NotificationSyncService"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
